# Backend environment example (set these on your host, or export locally)

# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com

# Comma-separated frontend origins for production CORS
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
