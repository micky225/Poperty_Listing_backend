# Backend environment example (set these on Render)

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=poperty-listing-backend.onrender.com

# Important: env overrides settings defaults. Include EVERY frontend origin.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://property-listing-frontend-iota.vercel.app,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://property-listing-frontend-iota.vercel.app,https://poperty-listing-backend.onrender.com
